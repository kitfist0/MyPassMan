<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API 30 and below.
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices running API 31 and above.
-->
<full-backup-content>
    <!-- The database is encrypted with a device-bound Keystore key that is never backed up. -->
    <exclude domain="database" path="." />
</full-backup-content>
